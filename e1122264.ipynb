    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Graph features\n",
        "\n",
        "In-degree and out-degree count incoming and outgoing payments. High in-degree is consistent with mixing; high out-degree is consistent with splitting.\n",
        ""
      ],
      "id": "s4"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Attach in-degree, out-degree, and their ratio from the full edge list.\n",
        "\n",
        "in_deg = edges.groupby(\"txId2\").size().reset_index(name=\"in_degree\")\n",
        "in_deg.columns = [\"txId\", \"in_degree\"]\n",
        "\n",
        "out_deg = edges.groupby(\"txId1\").size().reset_index(name=\"out_degree\")\n",
        "out_deg.columns = [\"txId\", \"out_degree\"]\n",
        "\n",
        "degrees = in_deg.merge(out_deg, on=\"txId\", how=\"outer\").fillna(0)\n",
        "degrees[\"in_degree\"] = degrees[\"in_degree\"].astype(int)\n",
        "degrees[\"out_degree\"] = degrees[\"out_degree\"].astype(int)\n",
        "degrees[\"total_degree\"] = degrees[\"in_degree\"] + degrees[\"out_degree\"]\n",
        "degrees[\"in_out_ratio\"] = degrees[\"in_degree\"] / (degrees[\"out_degree\"] + 1)\n",
        "\n",
        "graph_cols = [\"in_degree\", \"out_degree\", \"total_degree\", \"in_out_ratio\"]\n",
        "\n",
        "def add_graph_features(df):\n",
        "    out = df.drop(columns=[c for c in graph_cols if c in df.columns], errors=\"ignore\")\n",
        "    out = out.merge(degrees, on=\"txId\", how=\"left\")\n",
        "    out[graph_cols] = out[graph_cols].fillna(0)\n",
        "    return out\n",
        "\n",
        "train = add_graph_features(train)\n",
        "test = add_graph_features(test)\n",
        "labeled = add_graph_features(labeled)\n",
        "\n",
        "model_feature_cols = feature_cols + graph_cols\n",
        "print(f\"Model features: {len(model_feature_cols)} ({len(feature_cols)} feat_* + {len(graph_cols)} graph)\")\n",
        "print(labeled[graph_cols].describe().round(2))\n",
        ""
