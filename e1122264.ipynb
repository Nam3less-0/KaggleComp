    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. Validation\n",
        "\n",
        "The labeled set is split by time: earlier weeks are used for fitting and later weeks for evaluation, rather than a shuffled fold.\n",
        ""
      ],
      "id": "s5"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Hold out later labeled weeks so evaluation is chronological.\n",
        "\n",
        "VAL_START = 31\n",
        "\n",
        "train_fit = labeled[labeled[\"time_step\"] <= VAL_START - 1].copy()\n",
        "train_val = labeled[labeled[\"time_step\"] >= VAL_START].copy()\n",
        "\n",
        "print(f\"Train fit: {len(train_fit):,}  |  Val: {len(train_val):,}\")\n",
        "print(f\"Train fit time steps: {train_fit['time_step'].min()}–{train_fit['time_step'].max()}\")\n",
        "print(f\"Val time steps:       {train_val['time_step'].min()}–{train_val['time_step'].max()}\")\n",
        "print(f\"\\nTrain illicit rate: {train_fit['label'].mean():.4f}\")\n",
        "print(f\"Val illicit rate:   {train_val['label'].mean():.4f}\")\n",
        ""
      ],
      "execution_count": 59,
      "outputs": [
