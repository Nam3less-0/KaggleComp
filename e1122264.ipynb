    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "A substantial share of the supplied features are near-duplicates. The linear diagnostic loses some holdout ranking after they are dropped, which is expected: collinear aggregates can still help a linear model. The compact set is kept so later tree models are not dominated by redundant local summaries.\n",
        ""
      ],
      "id": "9973bfa7"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6b. Within-week ranks\n",
        "\n",
        "Each retained feature is ranked within its week so that week-to-week scale differences affect the model less. Weeks are not pooled.\n",
        ""
      ],
      "id": "f5e140f8"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Compute within-week ranks and drop those that duplicate the raw feature.\n",
        "\n",
        "print(\"corr-filtered features:\", len(corr_cols))\n",
        "PCT_PREFIX = \"ts_pct_\"\n",
        "\n",
        "universe = (\n",
        "    pd.concat(\n",
        "        [\n",
        "            train[[\"txId\", \"time_step\"] + corr_cols],\n",
        "            test[[\"txId\", \"time_step\"] + corr_cols],\n",
        "        ],\n",
        "        ignore_index=True,\n",
        "    )\n",
        "    .drop_duplicates(\"txId\")\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "pct = universe.groupby(\"time_step\")[corr_cols].rank(pct=True, method=\"average\")\n",
        "pct = pct.add_prefix(PCT_PREFIX)\n",
        "pct_raw_cols = [f\"{PCT_PREFIX}{c}\" for c in corr_cols]\n",
        "pct[\"txId\"] = universe[\"txId\"]\n",
        "pct[\"ts_n_high\"] = (pct[pct_raw_cols] >= 0.95).sum(axis=1).astype(int)\n",
        "pct[\"ts_n_low\"] = (pct[pct_raw_cols] <= 0.05).sum(axis=1).astype(int)\n",
        "pct[\"ts_pct_max\"] = pct[pct_raw_cols].max(axis=1)\n",
        "pct[\"ts_pct_min\"] = pct[pct_raw_cols].min(axis=1)\n",
        "summary_cols = [\"ts_n_high\", \"ts_n_low\", \"ts_pct_max\", \"ts_pct_min\"]\n",
        "\n",
        "def add_tspct(df):\n",
        "    drop = [c for c in pct_raw_cols + summary_cols if c in df.columns]\n",
        "    out = df.drop(columns=drop, errors=\"ignore\")\n",
        "    return out.merge(pct[[\"txId\"] + pct_raw_cols + summary_cols], on=\"txId\", how=\"left\")\n",
        "\n",
        "train = add_tspct(train)\n",
        "test = add_tspct(test)\n",
        "labeled = add_tspct(labeled)\n",
        "train_fit = add_tspct(train_fit)\n",
        "train_val = add_tspct(train_val)\n",
        "\n",
        "keep_pct = []\n",
        "dropped_dup = []\n",
        "for c in corr_cols:\n",
        "    pc = f\"{PCT_PREFIX}{c}\"\n",
        "    if train_fit[pc].nunique(dropna=False) < 2:\n",
        "        dropped_dup.append(pc)\n",
        "        continue\n",
        "    r = train_fit[c].astype(float).corr(train_fit[pc].astype(float))\n",
        "    if pd.notna(r) and abs(r) >= 0.95:\n",
        "        dropped_dup.append(pc)\n",
        "    else:\n",
        "        keep_pct.append(pc)\n",
        "\n",
        "dropped_colin = []\n",
        "if len(keep_pct) >= 2:\n",
        "    corr_p = train_fit[keep_pct].astype(float).corr().abs()\n",
        "    upper_p = corr_p.where(np.triu(np.ones(corr_p.shape), k=1).astype(bool))\n",
        "    dropped_colin = [col for col in upper_p.columns if any(upper_p[col] > 0.95)]\n",
        "    keep_pct = [c for c in keep_pct if c not in set(dropped_colin)]\n",
        "\n",
        "submission_cols = list(corr_cols) + keep_pct + summary_cols\n",
        "print(f\"Universe txs ranked: {len(universe):,} across {universe['time_step'].nunique()} time steps\")\n",
        "print(f\"Percentile cols computed: {len(pct_raw_cols)}\")\n",
        "print(f\"Dropped (dup of raw, |corr|>=0.95 or constant): {len(dropped_dup)}\")\n",
        "print(f\"Dropped (collinear with another percentile): {len(dropped_colin)}\")\n",
        "print(f\"Kept time-relative percentiles: {len(keep_pct)}\")\n",
        "print(f\"Plus summaries: {summary_cols}\")\n",
        "print(\n",
        "    f\"Features: {len(corr_cols)} corr-filtered + {len(keep_pct)} pct + {len(summary_cols)} summary = {len(submission_cols)}\"\n",
        ")\n",
        "print(labeled[summary_cols].describe().round(2))\n",
        "print(\"corr-filtered still in model cols:\", all(c in submission_cols for c in corr_cols))\n",
        "print(\"summary cols still in model cols:\", all(s in submission_cols for s in summary_cols))\n",
        "print(f\"\\nModel columns after week ranks: {len(submission_cols)}\")\n",
        ""
