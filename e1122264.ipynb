      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Most of the within-week ranks add information that is not a copy of the raw feature. The extremeness summaries show that labeled transactions often sit in the tail of at least some coordinates. That is useful for the goal: a payment can look ordinary in absolute scale in a busy week and still be extreme relative to that week.\n",
        ""
      ],
      "id": "b18404b7"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6c. Neighbor scores and week size\n",
        "\n",
        "Week volume is added as a covariate. Predicted scores, rather than neighbor labels, are aggregated along same-week payment edges, because illicit labels on neighbors are not available in later weeks.\n",
        ""
      ],
      "id": "140f2093"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Attach week volume, then aggregate out-of-fold scores over undirected payment neighbors.\n",
        "\n",
        "extra_keep = []\n",
        "\n",
        "def _keep_new(cols, train_fit, base_cols):\n",
        "    kept, dropped = [], []\n",
        "    now = list(base_cols)\n",
        "    for c in cols:\n",
        "        s = train_fit[c]\n",
        "        if s.nunique(dropna=False) < 2:\n",
        "            dropped.append((c, \"constant\"))\n",
        "            continue\n",
        "        corr_vs = train_fit[now].corrwith(s.astype(float)).abs()\n",
        "        m, hit = float(corr_vs.max()), corr_vs.idxmax()\n",
        "        if pd.notna(m) and m >= 0.95:\n",
        "            dropped.append((c, f\"corr {m:.3f} with {hit}\"))\n",
        "            continue\n",
        "        kept.append(c)\n",
        "        now.append(c)\n",
        "    return kept, dropped\n",
        "\n",
        "def _attach(df, tab, cols):\n",
        "    drop = [c for c in cols if c in df.columns]\n",
        "    out = df.drop(columns=drop, errors=\"ignore\")\n",
        "    return out.merge(tab, on=\"txId\", how=\"left\")\n",
        "\n",
        "def _push(tab, cols, tag):\n",
        "    global train, test, labeled, train_fit, train_val, extra_keep\n",
        "    train, test, labeled, train_fit, train_val = (\n",
        "        _attach(train, tab, cols),\n",
        "        _attach(test, tab, cols),\n",
        "        _attach(labeled, tab, cols),\n",
        "        _attach(train_fit, tab, cols),\n",
        "        _attach(train_val, tab, cols),\n",
        "    )\n",
        "    for df_ in (train, test, labeled, train_fit, train_val):\n",
        "        df_[cols] = df_[cols].fillna(0)\n",
        "    k, d = _keep_new(cols, train_fit, submission_cols + extra_keep)\n",
        "    extra_keep.extend(k)\n",
        "    print(tag, \"kept\", k, \"dropped\", d)\n",
        "\n",
        "week_n = (\n",
        "    pd.concat([train[[\"txId\", \"time_step\"]], test[[\"txId\", \"time_step\"]]], ignore_index=True)\n",
        "    .drop_duplicates(\"txId\")\n",
        "    .groupby(\"time_step\")\n",
        "    .size()\n",
        "    .rename(\"week_n\")\n",
        "    .reset_index()\n",
        ")\n",
        "train = train.drop(columns=[\"week_n\"], errors=\"ignore\").merge(week_n, on=\"time_step\", how=\"left\")\n",
        "test = test.drop(columns=[\"week_n\"], errors=\"ignore\").merge(week_n, on=\"time_step\", how=\"left\")\n",
        "labeled = labeled.drop(columns=[\"week_n\"], errors=\"ignore\").merge(week_n, on=\"time_step\", how=\"left\")\n",
        "train_fit = train_fit.drop(columns=[\"week_n\"], errors=\"ignore\").merge(week_n, on=\"time_step\", how=\"left\")\n",
        "train_val = train_val.drop(columns=[\"week_n\"], errors=\"ignore\").merge(week_n, on=\"time_step\", how=\"left\")\n",
        "k, d = _keep_new([\"week_n\"], train_fit, submission_cols + extra_keep)\n",
        "extra_keep.extend(k)\n",
        "print(\"week_n\", \"kept\" if k else \"dropped\", d)\n",
        "\n",
        "# Neighbor mean, spread, two-hop mean, and the difference between a transaction and its local neighborhood.\n",
        "NBR_COLS = [\"sna_nbr_pmean\", \"sna_nbr_pstd\", \"sna_nbr_p2hop\", \"sna_p_minus_nbr\"]\n",
        "\n",
        "\n",
        "def _undirected_A(edges, id_to_idx, n):\n",
        "    ed = edges[[\"txId1\", \"txId2\"]].copy()\n",
        "    i = ed[\"txId1\"].astype(np.int64).map(id_to_idx)\n",
        "    j = ed[\"txId2\"].astype(np.int64).map(id_to_idx)\n",
        "    ok = i.notna() & j.notna() & (i != j)\n",
        "    ii = i.loc[ok].astype(int).to_numpy()\n",
        "    jj = j.loc[ok].astype(int).to_numpy()\n",
        "    if len(ii) == 0:\n",
        "        return sparse.csr_matrix((n, n))\n",
        "    rows = np.concatenate([ii, jj])\n",
        "    cols = np.concatenate([jj, ii])\n",
        "    A = sparse.csr_matrix((np.ones(len(rows)), (rows, cols)), shape=(n, n))\n",
        "    A.data = np.ones_like(A.data)\n",
        "    A.setdiag(0)\n",
        "    A.eliminate_zeros()\n",
        "    return A.tocsr()\n",
        "\n",
        "\n",
        "def neighbor_score_table(edges, scores):\n",
        "    scores = scores.astype(float)\n",
        "    node_ids = scores.index.astype(np.int64).to_numpy()\n",
        "    id_to_idx = {int(t): i for i, t in enumerate(node_ids)}\n",
        "    n = len(node_ids)\n",
        "    A = _undirected_A(edges, id_to_idx, n)\n",
        "    p = scores.to_numpy(dtype=np.float64)\n",
        "    deg = np.asarray(A.sum(axis=1)).ravel()\n",
        "    nbr_sum = np.asarray(A @ p).ravel()\n",
        "    nbr_mean = np.divide(nbr_sum, deg, out=np.full(n, np.nan), where=deg > 0)\n",
        "    nbr_mean = np.where(np.isfinite(nbr_mean), nbr_mean, p)\n",
        "    nbr_sq = np.asarray(A @ (p * p)).ravel()\n",
        "    nbr_var = np.divide(nbr_sq, deg, out=np.zeros(n), where=deg > 0) - nbr_mean**2\n",
        "    nbr_std = np.sqrt(np.clip(nbr_var, 0, None))\n",
        "    two = np.asarray((A @ A) @ p).ravel()\n",
        "    two_deg = np.asarray((A @ A).sum(axis=1)).ravel()\n",
        "    two_mean = np.divide(two, two_deg, out=np.full(n, np.nan), where=two_deg > 0)\n",
        "    two_mean = np.where(np.isfinite(two_mean), two_mean, p)\n",
        "    return pd.DataFrame(\n",
        "        {\n",
        "            \"txId\": node_ids,\n",
        "            \"sna_nbr_pmean\": nbr_mean,\n",
        "            \"sna_nbr_pstd\": nbr_std,\n",
        "            \"sna_nbr_p2hop\": two_mean,\n",
        "            \"sna_p_minus_nbr\": p - nbr_mean,\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "y = labeled[\"label\"].to_numpy()\n",
        "X = labeled[submission_cols].astype(float)\n",
        "groups = labeled[\"time_step\"].to_numpy()\n",
        "oof = np.zeros(len(labeled), dtype=float)\n",
        "spw = (y == 0).sum() / max((y == 1).sum(), 1)\n",
        "gkf = GroupKFold(n_splits=5)\n",
        "for fold, (tr, ho) in enumerate(gkf.split(X, y, groups), 1):\n",
        "    m = LGBMClassifier(\n",
        "        n_estimators=150, max_depth=6, learning_rate=0.10,\n",
        "        subsample=0.8, colsample_bytree=0.8, scale_pos_weight=spw,\n",
        "        random_state=42, n_jobs=-1, verbosity=-1,\n",
        "    )\n",
        "    m.fit(X.iloc[tr], y[tr])\n",
        "    oof[ho] = m.predict_proba(X.iloc[ho])[:, 1]\n",
        "    print(f\"OOF fold {fold}/5\")\n",
        "full = LGBMClassifier(\n",
        "    n_estimators=150, max_depth=6, learning_rate=0.10,\n",
        "    subsample=0.8, colsample_bytree=0.8, scale_pos_weight=spw,\n",
        "    random_state=42, n_jobs=-1, verbosity=-1,\n",
        ")\n",
        "full.fit(X, y)\n",
        "score = pd.Series(\n",
        "    np.nan,\n",
        "    index=pd.Index(pd.concat([train[\"txId\"], test[\"txId\"]]).astype(\"int64\").unique(), name=\"txId\"),\n",
        ")\n",
        "score.loc[labeled[\"txId\"].astype(\"int64\").to_numpy()] = oof\n",
        "need = score[score.isna()].index\n",
        "rest = pd.concat(\n",
        "    [\n",
        "        train.loc[train[\"label\"].isna(), [\"txId\"] + submission_cols],\n",
        "        test[[\"txId\"] + submission_cols],\n",
        "    ],\n",
        "    ignore_index=True,\n",
        ").drop_duplicates(\"txId\")\n",
        "rest = rest[rest[\"txId\"].astype(\"int64\").isin(need)]\n",
        "if len(rest):\n",
        "    pred_rest = full.predict_proba(rest[submission_cols].astype(float))[:, 1]\n",
        "    score.loc[rest[\"txId\"].astype(\"int64\").to_numpy()] = pred_rest\n",
        "score = score.dropna()\n",
        "nbr = neighbor_score_table(edges, score)\n",
        "print(nbr[NBR_COLS].describe().round(4))\n",
        "_push(nbr, list(NBR_COLS), \"nbr\")\n",
        "\n",
        "if extra_keep:\n",
        "    submission_cols = list(submission_cols) + [c for c in extra_keep if c not in submission_cols]\n",
        "print(\"extra_keep\", extra_keep)\n",
        "print(\"model cols\", len(submission_cols))\n",
        ""
      ],
      "execution_count": 62,
      "outputs": [
        {
          "output_type": "stream",
          "text": [
            "week_n kept []\n",
            "OOF fold 1/5\n",
            "OOF fold 2/5\n",
            "OOF fold 3/5\n",
            "OOF fold 4/5\n",
            "OOF fold 5/5\n",
            "       sna_nbr_pmean  sna_nbr_pstd  sna_nbr_p2hop  sna_p_minus_nbr\n",
            "count    157101.0000   157101.0000    157101.0000      157101.0000\n",
            "mean          0.0924        0.0363         0.0912           0.0077\n",
            "std           0.2201        0.1032         0.1788           0.2628\n",
            "min           0.0000        0.0000         0.0000          -0.9999\n",
            "25%           0.0002        0.0000         0.0009          -0.0040\n",
            "50%           0.0021        0.0001         0.0104          -0.0000\n",
            "75%           0.0343        0.0054         0.0935           0.0038\n",
            "max           1.0000        0.5000         1.0000           1.0000\n",
            "nbr kept ['sna_nbr_pmean', 'sna_nbr_pstd', 'sna_nbr_p2hop', 'sna_p_minus_nbr'] dropped []\n",
            "extra_keep ['week_n', 'sna_nbr_pmean', 'sna_nbr_pstd', 'sna_nbr_p2hop', 'sna_p_minus_nbr']\n",
            "model cols 202\n"
          ],
          "name": "stdout"
        }
      ],
      "id": "c3aa1c12"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Week volume and the four neighbor-score columns are retained. Neighbor means are low for most transactions, with a long right tail, which matches rare illicit clusters on the payment graph. Because the signal is the model's own score, the same columns can be built on later weeks where neighbor labels do not exist.\n",
        ""
      ],
      "id": "27e91821"
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 7. Models\n",
        "\n",
        "A linear baseline, a random forest, three gradient-boosted trees, and a rank average of the trees are compared. Ranks are averaged because the models are not calibrated to a common probability scale. Class imbalance is addressed with a loss weight rather than oversampling.\n",
        ""
      ],
      "id": "s7"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Fit the comparison models on earlier labeled weeks and score later labeled weeks.\n",
        "\n",
        "N_TREES = 150\n",
        "LEARNING_RATE = 0.10\n",
        "MAX_DEPTH = 6\n",
        "\n",
        "\n",
        "def make_boosters(scale_pos_weight):\n",
        "    xgb = XGBClassifier(\n",
        "        n_estimators=N_TREES,\n",
        "        max_depth=MAX_DEPTH,\n",
        "        learning_rate=LEARNING_RATE,\n",
        "        subsample=0.8,\n",
        "        colsample_bytree=0.8,\n",
        "        scale_pos_weight=scale_pos_weight,\n",
        "        random_state=42,\n",
        "        eval_metric=\"logloss\",\n",
        "        n_jobs=-1,\n",
        "    )\n",
        "    lgbm = LGBMClassifier(\n",
        "        n_estimators=N_TREES,\n",
        "        max_depth=MAX_DEPTH,\n",
        "        learning_rate=LEARNING_RATE,\n",
        "        subsample=0.8,\n",
        "        colsample_bytree=0.8,\n",
        "        scale_pos_weight=scale_pos_weight,\n",
        "        random_state=42,\n",
        "        n_jobs=-1,\n",
        "        verbosity=-1,\n",
        "    )\n",
        "    cat = CatBoostClassifier(\n",
        "        iterations=N_TREES,\n",
        "        depth=MAX_DEPTH,\n",
        "        learning_rate=LEARNING_RATE,\n",
        "        scale_pos_weight=scale_pos_weight,\n",
        "        random_seed=42,\n",
        "        verbose=0,\n",
        "        allow_writing_files=False,\n",
        "    )\n",
        "    return xgb, lgbm, cat\n",
        "\n",
        "\n",
        "def rank_avg(*arrays):\n",
        "    ranks = [pd.Series(a).rank(pct=True) for a in arrays]\n",
        "    return (sum(ranks) / len(ranks)).to_numpy()\n",
        "\n",
        "X_fit = train_fit[submission_cols].astype(float)\n",
        "y_fit = train_fit[\"label\"]\n",
        "X_val = train_val[submission_cols].astype(float)\n",
        "y_val = train_val[\"label\"]\n",
        "scale_pos_weight = (y_fit == 0).sum() / max((y_fit == 1).sum(), 1)\n",
        "\n",
        "logreg = LogisticRegression(\n",
        "    class_weight=\"balanced\", max_iter=1000, random_state=42, n_jobs=-1\n",
        ")\n",
        "logreg.fit(X_fit, y_fit)\n",
        "\n",
        "rf = RandomForestClassifier(\n",
        "    n_estimators=N_TREES,\n",
        "    max_depth=MAX_DEPTH,\n",
        "    class_weight=\"balanced\",\n",
        "    random_state=42,\n",
        "    n_jobs=-1,\n",
        ")\n",
        "rf.fit(X_fit, y_fit)\n",
        "\n",
        "xgb, lgbm, cat = make_boosters(scale_pos_weight)\n",
        "xgb.fit(X_fit, y_fit)\n",
        "lgbm.fit(X_fit, y_fit)\n",
        "cat.fit(X_fit, y_fit)\n",
        "\n",
        "p_logreg = logreg.predict_proba(X_val)[:, 1]\n",
        "p_rf = rf.predict_proba(X_val)[:, 1]\n",
        "p_xgb = xgb.predict_proba(X_val)[:, 1]\n",
        "p_lgbm = lgbm.predict_proba(X_val)[:, 1]\n",
        "p_cat = cat.predict_proba(X_val)[:, 1]\n",
        "p_blend = rank_avg(p_lgbm, p_xgb, p_cat)\n",
        "p_logreg_xgb = rank_avg(p_logreg, p_xgb)\n",
        "\n",
        "\n",
        "def metric_row(name, y, p, threshold=0.5):\n",
        "    pred = (p >= threshold).astype(int)\n",
        "    return {\n",
        "        \"model\": name,\n",
        "        \"val_roc_auc\": roc_auc_score(y, p),\n",
        "        \"threshold\": threshold,\n",
        "        \"val_accuracy\": accuracy_score(y, pred),\n",
        "        \"val_precision\": precision_score(y, pred, zero_division=0),\n",
        "        \"val_recall\": recall_score(y, pred, zero_division=0),\n",
        "        \"val_f1\": f1_score(y, pred, zero_division=0),\n",
        "    }\n",
        "\n",
        "# Thresholded metrics use a cutoff matched to the holdout illicit rate rather than a default of one half.\n",
        "report_t = float(1.0 - y_val.mean())\n",
        "\n",
        "comparison = pd.DataFrame(\n",
        "    [\n",
        "        metric_row(\"LogReg (baseline)\", y_val, p_logreg, threshold=report_t),\n",
        "        metric_row(\"Random Forest\", y_val, p_rf, threshold=report_t),\n",
        "        metric_row(\"LogReg + XGB (equal ranks)\", y_val, p_logreg_xgb, threshold=report_t),\n",
        "        metric_row(\"XGBoost\", y_val, p_xgb, threshold=report_t),\n",
        "        metric_row(\"LightGBM\", y_val, p_lgbm, threshold=report_t),\n",
        "        metric_row(\"CatBoost\", y_val, p_cat, threshold=report_t),\n",
        "        metric_row(\n",
        "            f\"1/3 LGBM+XGB+Cat ({N_TREES} / {LEARNING_RATE:.2f} / d{MAX_DEPTH} + ts pct)\",\n",
        "            y_val,\n",
        "            p_blend,\n",
        "            threshold=report_t,\n",
        "        ),\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(\"Holdout metric = val_roc_auc (steps 31–35).\")\n",
        "print(\n",
        "    f\"P/R/F1 at threshold {report_t:.3f} \"\n",
        "    f\"(= 1 − val illicit rate {y_val.mean():.3f}).\\n\"\n",
        ")\n",
        "print(comparison.round(4).to_string(index=False))\n",
        ""
      ],
