      "source": [
        "## 8. Submission\n",
        "\n",
        "Models are refit on all labeled transactions. Two files are written that combine the neighbor-score model with a companion that excludes those features, so that graph-derived scores do not determine the ranking alone.\n",
        ""
      ],
      "id": "s8"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Refit on all labeled transactions and write the two rank mixes.\n",
        "\n",
        "submission_cols = list(corr_cols) + list(keep_pct) + list(summary_cols)\n",
        "if extra_keep:\n",
        "    submission_cols = submission_cols + [c for c in extra_keep if c not in submission_cols]\n",
        "print(\"corr-filtered still in model cols:\", all(c in submission_cols for c in corr_cols))\n",
        "print(\"model cols:\", len(submission_cols))\n",
        "\n",
        "N_TREES = 150\n",
        "LEARNING_RATE = 0.10\n",
        "MAX_DEPTH = 6\n",
        "MIX_21 = (2, 1)\n",
        "MIX_31 = (3, 1)\n",
        "METHOD_21 = \"lgbm_xgb_cat_tspct_150_0.10_nbr_b200_bb21\"\n",
        "METHOD_31 = \"lgbm_xgb_cat_tspct_150_0.10_nbr_b200_bb31\"\n",
        "\n",
        "\n",
        "def make_boosters(scale_pos_weight):\n",
        "    xgb = XGBClassifier(\n",
        "        n_estimators=N_TREES,\n",
        "        max_depth=MAX_DEPTH,\n",
        "        learning_rate=LEARNING_RATE,\n",
        "        subsample=0.8,\n",
        "        colsample_bytree=0.8,\n",
        "        scale_pos_weight=scale_pos_weight,\n",
        "        random_state=42,\n",
        "        eval_metric=\"logloss\",\n",
        "        n_jobs=-1,\n",
        "    )\n",
        "    lgbm = LGBMClassifier(\n",
        "        n_estimators=N_TREES,\n",
        "        max_depth=MAX_DEPTH,\n",
        "        learning_rate=LEARNING_RATE,\n",
        "        subsample=0.8,\n",
        "        colsample_bytree=0.8,\n",
        "        scale_pos_weight=scale_pos_weight,\n",
        "        random_state=42,\n",
        "        n_jobs=-1,\n",
        "        verbosity=-1,\n",
        "    )\n",
        "    cat = CatBoostClassifier(\n",
        "        iterations=N_TREES,\n",
        "        depth=MAX_DEPTH,\n",
        "        learning_rate=LEARNING_RATE,\n",
        "        scale_pos_weight=scale_pos_weight,\n",
        "        random_seed=42,\n",
        "        verbose=0,\n",
        "        allow_writing_files=False,\n",
        "    )\n",
        "    return xgb, lgbm, cat\n",
        "\n",
        "\n",
        "def rank_avg(*arrays, weights=None):\n",
        "    ranks = [pd.Series(a).rank(pct=True) for a in arrays]\n",
        "    if weights is None:\n",
        "        return (sum(ranks) / len(ranks)).to_numpy()\n",
        "    w = np.asarray(weights, dtype=float)\n",
        "    w = w / w.sum()\n",
        "    return sum(wi * r for wi, r in zip(w, ranks)).to_numpy()\n",
        "\n",
        "X_all = labeled[submission_cols].astype(float)\n",
        "y_all = labeled[\"label\"]\n",
        "X_test = test[submission_cols].astype(float)\n",
        "spw = (y_all == 0).sum() / max((y_all == 1).sum(), 1)\n",
        "\n",
        "\n",
        "def fit_blend(n_trees, lr):\n",
        "    global N_TREES, LEARNING_RATE\n",
        "    N_TREES, LEARNING_RATE = n_trees, lr\n",
        "    xgb, lgbm, cat = make_boosters(spw)\n",
        "    xgb.fit(X_all, y_all)\n",
        "    lgbm.fit(X_all, y_all)\n",
        "    cat.fit(X_all, y_all)\n",
        "    return rank_avg(\n",
        "        lgbm.predict_proba(X_test)[:, 1],\n",
        "        xgb.predict_proba(X_test)[:, 1],\n",
        "        cat.predict_proba(X_test)[:, 1],\n",
        "    )\n",
        "\n",
        "test_probs = fit_blend(150, 0.10)\n",
        "p200 = fit_blend(200, 0.08)\n",
        "test_probs = rank_avg(test_probs, p200)\n",
        "print(\"rank-averaged 150/0.10 with 200/0.08\")\n",
        "sna_cols = [c for c in submission_cols if c.startswith(\"sna_\")]\n",
        "base_cols = [c for c in submission_cols if c not in sna_cols]\n",
        "X_all = labeled[base_cols].astype(float)\n",
        "X_test = test[base_cols].astype(float)\n",
        "p_base = rank_avg(fit_blend(150, 0.10), fit_blend(200, 0.08))\n",
        "p_21 = rank_avg(test_probs, p_base, weights=MIX_21)\n",
        "p_31 = rank_avg(test_probs, p_base, weights=MIX_31)\n",
        "print(f\"2:1 and 3:1 mixes with no-sna clone ({len(base_cols)} cols)\")\n",
        "\n",
        "sample = pd.read_csv(DATA_DIR / \"sample_submission.csv\")\n",
        "for name, probs in ((METHOD_21, p_21), (METHOD_31, p_31)):\n",
        "    submission = sample.copy()\n",
        "    submission[\"target\"] = probs\n",
        "    out_path = SUBMISSIONS_DIR / f\"{name}.csv\"\n",
        "    submission.to_csv(out_path, index=False)\n",
        "    print(f\"Saved: {out_path}  range {probs.min():.4f}–{probs.max():.4f}\")\n",
        ""
      ],
